{
  "name": "astro-wheel",
  "version": "0.1.0",
  "private": true,
  "description": "Composable, framework-agnostic SVG chart wheel: the sky flattened onto the zodiac.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "astrology",
    "chart",
    "horoscope",
    "natal-chart",
    "svg",
    "zodiac"
  ],
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
